# Azure Table Storage Configuration

# -------------------------------------------------------------
# Option 1: Managed Identity on Azure Container Apps (Recommended for Azure)
# -------------------------------------------------------------
# AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount
# AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net

# -------------------------------------------------------------
# Option 2: Azure Storage Connection String
# -------------------------------------------------------------
# AZURE_TABLES_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# -------------------------------------------------------------
# Option 3: Local Development with Azurite Emulator
# -------------------------------------------------------------
# AZURE_TABLES_CONNECTION_STRING=UseDevelopmentStorage=true

# -------------------------------------------------------------
# General Settings
# -------------------------------------------------------------
TABLE_NAME=demotable
PORT=8000
